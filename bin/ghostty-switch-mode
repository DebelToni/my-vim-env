#!/usr/bin/env bash
set -euo pipefail

GHOSTTY_DIR="$HOME/.config/ghostty"
ACTIVE="$GHOSTTY_DIR/modes/active.conf"
HORSE_CONTROLS="$GHOSTTY_DIR/modes/horse.controls.conf"
HORSE_GENERATED="$GHOSTTY_DIR/modes/horse.generated.conf"

usage() {
  printf "%s\n" "Usage: $0 <layer> [layer ...]"
  printf "%s\n" "Layers: default lightsaber transparent_image horse complete_hackermode"
  printf "%s\n" "Example: $0 default horse"
}

clamp_1_9() {
  local value="$1"
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    value=5
  fi
  if (( value < 1 )); then
    value=1
  fi
  if (( value > 9 )); then
    value=9
  fi
  printf "%s" "$value"
}

generate_horse_controls() {
  local triangle_size=5
  local triangle_count=5

  if [[ -f "$HORSE_CONTROLS" ]]; then
    while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
      local line="${raw_line%%#*}"
      line="${line%$'\r'}"
      [[ -z "${line//[[:space:]]/}" ]] && continue
      [[ "$line" != *"="* ]] && continue

      local key="${line%%=*}"
      local val="${line#*=}"
      key="${key//[[:space:]]/}"
      val="${val//[[:space:]]/}"

      case "$key" in
        triangle-size)
          triangle_size="$val"
          ;;
        triangle-count)
          triangle_count="$val"
          ;;
      esac
    done < "$HORSE_CONTROLS"
  fi

  triangle_size="$(clamp_1_9 "$triangle_size")"
  triangle_count="$(clamp_1_9 "$triangle_count")"

  local size_red=$(( (triangle_size - 1) * 255 / 8 ))
  local count_red=$(( (triangle_count - 1) * 255 / 8 ))
  local size_hex
  local count_hex
  printf -v size_hex "%02x" "$size_red"
  printf -v count_hex "%02x" "$count_red"

  mkdir -p "$(dirname "$HORSE_GENERATED")"
  cat > "$HORSE_GENERATED" <<EOF
# Auto-generated by ghostty-switch-mode.
# Source: $HORSE_CONTROLS
# triangle-size=$triangle_size triangle-count=$triangle_count
selection-background = #${size_hex}ffff
selection-foreground = #${count_hex}ffff
EOF
}

if [[ "$#" -lt 1 ]]; then
  usage
  exit 1
fi

tmp="${ACTIVE}.tmp"
{
  printf "%s\n" "# Auto-generated by ghostty-switch-mode"
  printf "%s\n" "# Reload Ghostty config with Cmd+Shift+,"

  printed_transparent_image=0
  horse_selected=0

  for layer in "$@"; do
    case "$layer" in
      transparent_image)
        if (( printed_transparent_image == 0 )); then
          printf "%s\n" "config-file = ./transparent_image.conf"
          printed_transparent_image=1
        fi
        ;;
      horse)
        horse_selected=1
        if (( printed_transparent_image == 0 )); then
          printf "%s\n" "config-file = ./transparent_image.conf"
          printed_transparent_image=1
        fi
        printf "%s\n" "config-file = ./horse.conf"
        ;;
      default|lightsaber|complete_hackermode)
        printf "config-file = ./%s.conf\n" "$layer"
        ;;
      *)
        printf "%s\n" "Unknown layer: $layer" >&2
        rm -f "$tmp"
        usage >&2
        exit 1
        ;;
    esac
  done

  if (( horse_selected == 1 )); then
    generate_horse_controls
  fi
} > "$tmp"

mv "$tmp" "$ACTIVE"
printf "%s\n" "Updated $ACTIVE"
